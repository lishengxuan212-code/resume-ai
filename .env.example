AI_PROVIDERS=deepseek,qwen
# Server-only complete-response deadline per attempt (1000–300000 ms).
# Longer resumes need more than 30 seconds; the default is 120 seconds.
AI_TIMEOUT_MS=120000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_MODEL=

# Invitation access control. Production always requires these values.
ACCESS_REQUIRED=true
# Initial strategy for a new database. The admin console can change it later.
INVITE_REQUIRED_DEFAULT=true
ACCESS_DB_PATH=./data/resume-app.db
INVITE_PEPPER=
SESSION_HMAC_SECRET=
ACCESS_SESSION_DAYS=14
ADMIN_SESSION_HOURS=8
# Local console login. Keep bypass disabled when checking the password flow.
ADMIN_LOCAL_BYPASS=false
ADMIN_LOCAL_PASSWORD_MIN_LENGTH=12
# Optional login hint. Never use a hint that reveals the password.
ADMIN_LOGIN_HINT=
# Local testing may set this to false. Production always enforces invite quotas.
INVITE_QUOTAS_ENABLED=true
INVITE_DAILY_FLOW_LIMIT=2
INVITE_TOTAL_FLOW_LIMIT=20
INVITE_DAILY_EXTRACT_LIMIT=6
INVITE_DAILY_DIAGNOSE_LIMIT=3
INVITE_DAILY_EXPORT_LIMIT=6

# Estimated cost uses the measured mean of 0.00967 yuan per external request.
EXTERNAL_REQUEST_COST_MICROS=9670
DAILY_EXTERNAL_ALERT_YUAN=5
DAILY_EXTERNAL_BUDGET_YUAN=10
WRITE_REQUESTS_PER_HOUR=30
REDEEM_REQUESTS_PER_15_MINUTES=10
