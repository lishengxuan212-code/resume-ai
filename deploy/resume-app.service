[Unit]
Description=Resume validation web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resumeapp
Group=resumeapp
WorkingDirectory=/opt/resume-app/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/resume-app.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/resume-app
MemoryMax=768M
CPUQuota=150%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
