# PocketBay injects PORT and POCKETBAY_DATA_DIR. Do not set PORT manually.
NODE_ENV=production
HOST=0.0.0.0

# Select one or more providers in fallback order.
AI_PROVIDERS=deepseek,qwen
AI_TIMEOUT_MS=120000
OPENAI_API_KEY=replace-with-secret
OPENAI_MODEL=replace-with-model
DEEPSEEK_API_KEY=replace-with-secret
DEEPSEEK_MODEL=replace-with-model
QWEN_API_KEY=replace-with-secret
QWEN_MODEL=replace-with-model

# Public access control. Generate both secrets independently with 32+ random characters.
ACCESS_REQUIRED=true
# Start a new test deployment without an invite gate; the admin console can change this later.
INVITE_REQUIRED_DEFAULT=false
INVITE_PEPPER=replace-with-32-plus-random-characters
SESSION_HMAC_SECRET=replace-with-32-plus-random-characters
ACCESS_SESSION_DAYS=14
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_HINT=简历01

# Used only to create the first administrator in an empty persistent database.
# PocketBay production requires 12-128 characters. Use a password unrelated to any hint.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password

INVITE_QUOTAS_ENABLED=true
INVITE_DAILY_FLOW_LIMIT=2
INVITE_TOTAL_FLOW_LIMIT=20
INVITE_DAILY_EXTRACT_LIMIT=6
INVITE_DAILY_DIAGNOSE_LIMIT=3
INVITE_DAILY_EXPORT_LIMIT=6

EXTERNAL_REQUEST_COST_MICROS=9670
DAILY_EXTERNAL_ALERT_YUAN=5
DAILY_EXTERNAL_BUDGET_YUAN=10
WRITE_REQUESTS_PER_HOUR=30
REDEEM_REQUESTS_PER_15_MINUTES=10
